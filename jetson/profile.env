# Jetson AGX Orin, L4T R36.4, CUDA 12.6, CPython 3.12.
export PYTORCH_BUILD_VERSION=2.11.0+orinfer1
export PYTORCH_BUILD_NUMBER=1
export TORCH_CUDA_ARCH_LIST=8.7
export CC=/usr/bin/clang-20 CXX=/usr/bin/clang++-20
export CUDAHOSTCXX=/usr/bin/g++-11 CMAKE_CUDA_HOST_COMPILER=/usr/bin/g++-11
export CXXFLAGS='--gcc-install-dir=/usr/lib/gcc/aarch64-linux-gnu/11 -fclang-abi-compat=17'
export CMAKE_CXX_FLAGS_RELEASE='-O2 -DNDEBUG'
export CMAKE_C_FLAGS_RELEASE='-O2 -DNDEBUG'
export CMAKE_BUILD_TYPE=Release
export TORCH_NVCC_FLAGS='-Xfatbin -compress-all -compress-mode=balance'
export BUILD_TEST=0 BUILD_BINARY=0 BUILD_LIBTORCHLESS=0 BUILD_PYTHON_ONLY=0
export USE_CUDA=1 USE_CUDNN=1 USE_CUSPARSELT=0 USE_CUDSS=0 USE_CUFILE=0
export USE_DISTRIBUTED=1 USE_GLOO=1 USE_NCCL=1 USE_SYSTEM_NCCL=1
export USE_MPI=0 USE_TENSORPIPE=0 USE_NVSHMEM=0 USE_XCCL=0
export USE_BLAS=1 BLAS=OpenBLAS USE_OPENMP=0
export USE_PRIORITIZED_TEXT_FOR_LD=1
export USE_NNPACK=0 USE_PYTORCH_QNNPACK=0 USE_XNNPACK=0 USE_FBGEMM=0
export USE_MKLDNN=0 USE_KINETO=0 USE_ITT=0
export USE_FLASH_ATTENTION=0 USE_MEM_EFF_ATTENTION=1
export USE_NATIVE_ARCH=0 USE_NUMPY=1
export MAX_JOBS=${MAX_JOBS:-6}
export CMAKE_BUILD_PARALLEL_LEVEL=$MAX_JOBS
